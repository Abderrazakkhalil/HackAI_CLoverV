# ============================================================
# Hirfati / HackAI — environment variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Supabase (app runtime) ---------------------------------
# Get from: Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...      # anon/public key (optional)

# Seed user (auto-created by seed script, change before production)
SEED_USER_EMAIL=seed@hirfati.local
SEED_USER_PASSWORD=seed-password-change-me

# Price recommendation: number of comparable listings fed to the LLM
PRICE_TOP_K=8

# NOTE: SUPABASE_PROJECT_REF and SUPABASE_ACCESS_TOKEN in
# .claude/settings.json are for the MCP dev tool ONLY — not used at runtime.

# --- AI / Speech --------------------------------------------
GROQ_API_KEY=gsk_...
HF_TOKEN=hf_...

# --- Server -------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
