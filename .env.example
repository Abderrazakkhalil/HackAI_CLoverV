# ─── Hirfati — environment ──────────────────────────────────────────────
# Copy to ".env" (repo root) and fill in. Never commit ".env".

# --- LLM: Groq (primary + fallback) ---
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Speech-to-Text: MoulSot Gradio Space ---
HF_TOKEN=
ASR_SPACE=atlasia/MoulSot.v0.3

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Social Commerce: Meta Graph API (Facebook Page publishing) ---
# https://developers.facebook.com/apps  →  app + Facebook Page
META_APP_ID=
META_APP_SECRET=
# OAuth redirect — must match a "Valid OAuth Redirect URI" in the Meta app
# (Facebook Login → Settings). Defaults to FRONTEND_ORIGIN if left blank.
META_REDIRECT_URI=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
META_GRAPH_VERSION=v21.0
